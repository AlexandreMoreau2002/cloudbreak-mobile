# Production — mock désactivé, vrai backend
EXPO_PUBLIC_MOCK_API=false
EXPO_PUBLIC_API_URL=https://api.cloudbreak-app.com

# Outils de dev — désactivés par défaut, même sur un build __DEV__
# EXPO_PUBLIC_DEBUG=true       # active les logs console.debug (requêtes réseau, cache, AsyncState)
# EXPO_PUBLIC_DEV_TOOLS=true   # affiche le bloc "DEV ·" du profil (sandbox, reset sommet, rejouer onboarding)

# Pages légales — service cloudbreak-ops (domaine réservé, pas encore déployé en prod)
EXPO_PUBLIC_LEGAL_BASE_URL=https://ops.cloudbreak-app.com

# Développement local — pour travailler sur le simulateur ou un iPhone, remplacer les lignes ci-dessus :
# Simulateur iOS + backend Docker local :
# EXPO_PUBLIC_API_URL=http://localhost:8000
# iPhone + backend Docker local (IP Wi-Fi du Mac : ipconfig getifaddr en0) :
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8000
# Environnement dev déployé (Dokploy) :
# EXPO_PUBLIC_API_URL=https://dev-api.cloudbreak-app.com
# EXPO_PUBLIC_LEGAL_BASE_URL=https://dev-ops.cloudbreak-app.com

# Email support — pas encore définitif, à remplacer quand l'adresse sera choisie
EXPO_PUBLIC_SUPPORT_EMAIL=contact@cloudbreak-app.com
